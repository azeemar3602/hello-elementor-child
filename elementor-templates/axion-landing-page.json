      "elType": "section",
      "isInner": false,
      "settings": {
        "css_classes": "ax-section ax-faq",
        "custom_id": "resources",
        "content_width": "full",
        "padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
